# Google Cloud Configuration
GCP_PROJECT_ID=thermaplan-ai
GCP_REGION=asia-south1
VERTEX_REGION=global
VERTEX_LIVE_REGION=us-central1

# BigQuery
BIGQUERY_DATASET=teevra_manufacturing_asia_south1

# Cloud Storage
GCS_BUCKET_NAME=thermaplan-ai-teevra-uploads

# Pub/Sub Topics
PUBSUB_TOPIC_MACHINE_FAULTS=teevra-machine-faults
PUBSUB_TOPIC_WEATHER_ALERTS=teevra-weather-alerts
PUBSUB_TOPIC_SAFETY_SIGNALS=teevra-safety-signals

# Firestore
FIRESTORE_DATABASE=(default)

# Open-Meteo Weather Coordinates (Telangana / Hyderabad Industrial Corridor)
PLANT_LATITUDE=17.3850
PLANT_LONGITUDE=78.4867

# App runtime settings
LOG_LEVEL=INFO
ENVIRONMENT=development
USE_MOCK_FALLBACK_IF_CLOUD_UNAVAILABLE=true

# Telegram incident alerts. Keep the real values in .env only.
TELEGRAM_BOT_TOKEN=
CHAT_ID=
